# Uploaded files only; never execute scripts from this directory.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|phps|cgi|pl|py|sh|asp|aspx|jsp)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|phps|cgi|pl|py|sh|asp|aspx|jsp)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
